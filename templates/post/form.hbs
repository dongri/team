{{#*inline "title"}}New {{kind_title}} - Team{{/inline}}
{{#*inline "page_head"}}
{{> post/head}}
{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title">New {{kind_title}}</h1>

  <form action="/{{kind}}/create" method="post" class="post-form">
    <div class="form-field">
      <input type="text" placeholder="Title" name="title" class="input input-lg" id="{{kind}}-title" required>
    </div>
    <div class="form-field">
      <textarea name="body" id="{{kind}}-mdeditor" hidden></textarea>
      <label class="btn btn-ghost btn-sm file-label">
        <i class="far fa-file-image"></i>
        Attach an image
        <input type="file" name="image" id="post-image" hidden>
      </label>
    </div>
    <div class="form-field">
      <input type="text" placeholder="Tags (e.g. rust,tips,postgres)" name="tags" class="input">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" name="action" value="publish">Publish</button>
      <button type="submit" class="btn btn-ghost" name="action" value="draft">Save draft</button>
    </div>
  </form>

  <script>
    // Nippo template & today's date as title
    var nippoEditor = document.getElementById('nippo-mdeditor');
    if (nippoEditor) {
      nippoEditor.value = "# 本日の作業内容\n\n# 発生した問題\n\n# 明日の作業予定\n\n# 所感\n\n";
      var today = new Date();
      var mm = String(today.getMonth() + 1).padStart(2, '0');
      var dd = String(today.getDate()).padStart(2, '0');
      document.getElementById('nippo-title').value = today.getFullYear() + '/' + mm + '/' + dd;
    }

    var simplemde = new SimpleMDE({
      element: document.getElementById('{{kind}}-mdeditor'),
      spellChecker: false,
      status: false
    });

    document.getElementById('post-image').addEventListener('change', function () {
      if (!this.files.length) return;
      var input = this;
      var file = input.files[0];
      if (file.size > 20 * 1024 * 1024) {
        alert('ファイルサイズが大きすぎます(最大20MB)');
        input.value = '';
        return;
      }
      var fd = new FormData();
      fd.append('file', file);
      fetch('/image/upload', { method: 'POST', body: fd })
        .then(function (res) {
          return res.json().then(function (json) {
            if (!res.ok) throw new Error(json.error || 'アップロードに失敗しました');
            return json;
          });
        })
        .then(function (json) {
          simplemde.value(simplemde.value() + "\n![](" + json.fileurl + ")");
        })
        .catch(function (err) {
          alert(err.message);
          input.value = '';
        });
    });
  </script>
{{/inline}}
{{~> layout ~}}
