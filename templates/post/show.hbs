{{#*inline "title"}}{{post.title}} - Team{{/inline}}
{{#*inline "page_head"}}
{{> post/head}}
{{/inline}}
{{#*inline "page"}}
  <article class="post">
    <div class="post-actions">
      {{#if shared}}
      <span class="badge badge-info"><i class="fas fa-users"></i> Co-editing</span>
      {{else}}
      {{#if deletable}}
      <form method="post" action="/{{kind}}/share/{{post.id}}">
        <button class="btn btn-ghost btn-sm"><i class="fas fa-users"></i> Co-editing</button>
      </form>
      {{/if}}
      {{/if}}

      {{#if stocked}}
      <form method="post" action="/{{kind}}/unstock/{{post.id}}">
        <button class="btn btn-primary btn-sm"><i class="fas fa-bookmark"></i> Stocked</button>
      </form>
      {{else}}
      <form method="post" action="/{{kind}}/stock/{{post.id}}">
        <button class="btn btn-ghost btn-sm"><i class="far fa-bookmark"></i> Stock</button>
      </form>
      {{/if}}

      {{#if pinned}}
      <form method="post" action="/{{kind}}/unpin/{{post.id}}">
        <button class="btn btn-primary btn-sm"><i class="fas fa-thumbtack"></i> Unpin</button>
      </form>
      {{else}}
      <form method="post" action="/{{kind}}/pin/{{post.id}}">
        <button class="btn btn-ghost btn-sm"><i class="fas fa-thumbtack"></i> Pin</button>
      </form>
      {{/if}}

      <span class="post-actions-spacer"></span>

      {{#if editable}}
      <a class="btn btn-ghost btn-sm" href="/{{kind}}/edit/{{post.id}}"><i class="fas fa-edit"></i> Edit</a>
      {{/if}}
      {{#if deletable}}
      <button class="btn btn-danger btn-sm" type="button" onclick="removePost('{{kind}}', '{{post.id}}')"><i class="fas fa-trash-alt"></i> Delete</button>
      {{/if}}
    </div>

    <h1 class="post-title">{{post.title}}</h1>

    <div class="post-byline">
      <a class="item-avatar" href="/{{post.user.username}}">
        {{> partials/avatar post.user cls="avatar-md" px=40}}
      </a>
      <div>
        <a class="item-user" href="/{{post.user.username}}">@{{post.user.username}}</a>
        <div class="item-date">{{post.formated_created}}</div>
      </div>
    </div>

    <div class="post-tags" id="tags_view">
      <i class="fas fa-tags"></i>
      {{#each post.tags}}
      <a class="tag-pill" href="/tag?name={{name}}">{{name}}</a>
      {{/each}}
      <button class="icon-btn" type="button" onclick="editTags()" aria-label="Edit tags"><i class="fas fa-edit"></i></button>
    </div>
    <div id="tags_input" hidden>
      <form action="/{{kind}}/tags/{{post.id}}" method="post" class="tags-form">
        <input type="hidden" name="id" value="{{post.id}}">
        <input type="text" value="{{#each post.tags}}{{name}},{{/each}}" name="tags" class="input">
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-sm">Update tags</button>
          <button type="button" class="btn btn-ghost btn-sm" onclick="editTagsCancel()">Cancel</button>
        </div>
      </form>
    </div>

    <div class="post-markdown card">
      <div class="marked" hidden>{{post.body}}</div>
    </div>
  </article>

  <section class="comments">
    <h2 class="section-title">Comments</h2>
    <ul class="item-list">
      {{#each comments}}
      <li class="item-card comment-card">
        <a class="item-avatar" href="/{{comment.user.username}}">
          {{> partials/avatar comment.user cls="avatar-md" px=40}}
        </a>
        <div class="item-main">
          <div class="item-meta">
            <a class="item-user" href="/{{comment.user.username}}">@{{comment.user.username}}</a>
            <span class="item-date">{{comment.formated_created}}</span>
            {{#if editable}}
            <span class="comment-tools">
              <button class="icon-btn" type="button" onclick="editComment({{comment.id}})" aria-label="Edit"><i class="fas fa-edit"></i></button>
              <button class="icon-btn" type="button" onclick="removeComment({{comment.id}})" aria-label="Delete"><i class="fas fa-trash-alt"></i></button>
            </span>
            {{/if}}
          </div>
          <div class="marked" hidden id="comment_view_{{comment.id}}">{{comment.body}}</div>
          <form action="/{{kind}}/comment/{{comment.id}}" method="post" id="comment_input_{{comment.id}}" hidden>
            <input type="hidden" name="action" value="update" id="comment_action_{{comment.id}}">
            <div class="form-field">
              <textarea placeholder="Comment" name="body" class="textarea" required>{{comment.body}}</textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-sm">Update</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="editCommentCancel({{comment.id}})">Cancel</button>
            </div>
          </form>
        </div>
      </li>
      {{/each}}
    </ul>

    <form class="comment-form" action="/{{kind}}/comment" method="post">
      <input type="hidden" name="id" value="{{post.id}}">
      <div class="form-field">
        <textarea class="textarea" placeholder="Post a comment" name="body" id="input-comment" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Comment</button>
    </form>
  </section>

  <script>
    function editComment(id) {
      document.getElementById('comment_view_' + id).hidden = true;
      document.getElementById('comment_input_' + id).hidden = false;
    }
    function editCommentCancel(id) {
      var form = document.getElementById('comment_input_' + id);
      form.reset(); // discard unsaved edits
      form.hidden = true;
      document.getElementById('comment_view_' + id).hidden = false;
    }
    function removeComment(id) {
      if (confirm('Are you sure?')) {
        document.getElementById('comment_action_' + id).value = 'delete';
        // Submit the (still hidden) edit form — unhiding it here would
        // flash the edit UI before the page navigates.
        document.getElementById('comment_input_' + id).submit();
      }
    }
    function editTags() {
      document.getElementById('tags_view').hidden = true;
      document.getElementById('tags_input').hidden = false;
    }
    function editTagsCancel() {
      document.getElementById('tags_view').hidden = false;
      document.getElementById('tags_input').hidden = true;
    }
    function removePost(kind, id) {
      if (confirm('Are you sure?')) {
        // Deletion is a POST so it cannot be triggered by a crafted link or
        // image URL.
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '/' + encodeURIComponent(kind) + '/delete/' + encodeURIComponent(id);
        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>
{{/inline}}
{{~> layout ~}}
