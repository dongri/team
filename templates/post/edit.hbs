{{#*inline "title"}}Update {{kind_title}} - Team{{/inline}}
{{#*inline "page_head"}}
{{> post/head}}
{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title">Update {{kind_title}}</h1>

  <form action="/{{kind}}/update" method="post" class="post-form">
    <input type="hidden" name="id" value="{{post.id}}">
    <div class="form-field">
      <input type="text" placeholder="Title" name="title" value="{{post.title}}" class="input input-lg" required>
    </div>
    <div class="form-field">
      <textarea name="body" id="mdeditor" hidden required>{{post.body}}</textarea>
      <label class="btn btn-ghost btn-sm file-label">
        <i class="far fa-file-image"></i>
        Attach an image
        <input type="file" name="image" id="post-image" hidden>
      </label>
    </div>
    <div class="form-field">
      <input type="text" placeholder="Tags (e.g. rust,tips,postgres)" name="tags" value="{{tags}}" class="input">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" name="action" value="publish">Update &amp; publish</button>
      <button type="submit" class="btn btn-ghost" name="action" value="draft">Save draft</button>
      <a class="btn btn-ghost" href="/{{kind}}/show/{{post.id}}">Cancel</a>
    </div>
  </form>

  <script>
    var simplemde = new SimpleMDE({
      element: document.getElementById('mdeditor'),
      spellChecker: false,
      status: false
    });

    document.getElementById('post-image').addEventListener('change', function () {
      if (!this.files.length) return;
      var input = this;
      var file = input.files[0];
      if (file.size > 20 * 1024 * 1024) {
        alert('ファイルサイズが大きすぎます(最大20MB)');
        input.value = '';
        return;
      }
      var fd = new FormData();
      fd.append('file', file);
      fetch('/image/upload', { method: 'POST', body: fd })
        .then(function (res) {
          return res.json().then(function (json) {
            if (!res.ok) throw new Error(json.error || 'アップロードに失敗しました');
            return json;
          });
        })
        .then(function (json) {
          simplemde.value(simplemde.value() + "\n![](" + json.fileurl + ")");
        })
        .catch(function (err) {
          alert(err.message);
          input.value = '';
        });
    });
  </script>
{{/inline}}
{{~> layout ~}}
