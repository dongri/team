{{#*inline "title"}}{{kind_title}} - Team{{/inline}}
{{#*inline "page"}}
  <div class="page-head">
    <h1 class="page-title">{{kind_title}}</h1>
    <a class="btn btn-primary" href="/{{kind}}/new"><i class="fas fa-pen"></i> {{new_title}}</a>
  </div>

  <ul class="item-list">
    {{#each posts}}
    {{> partials/post_item}}
    {{/each}}
  </ul>

  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/{{kind}}/list?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/{{kind}}/list?page={{next_page}}">Next &rarr;</a>
  </nav>
{{/inline}}
{{~> layout ~}}
