{{#*inline "title"}}Sign up - Team{{/inline}}
{{#*inline "page_header"}}{{/inline}}
{{#*inline "page"}}
  <div class="auth-card">
    <div class="auth-brand"><img class="brand-logo brand-logo-lg" src="/img/logo.svg" alt="Team"></div>
    <h1 class="auth-title">Create your account</h1>
    <p class="auth-sub">Join your team</p>

    {{#if error_message}}
    <div class="alert alert-error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error_message}}</span>
  </div>
    {{/if}}

    {{#if google_enabled}}
    <a class="btn btn-google" href="/auth/google">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      <span>Sign up with Google</span>
    </a>

    <div class="auth-divider"><span>or</span></div>
    {{/if}}

    {{#if signup_enabled}}
    <form action="/signup" method="post" class="auth-form">
      <div class="form-field">
        <label class="form-label" for="username">Username</label>
        <input class="input" id="username" type="text" placeholder="Username" name="username" required maxlength="39" pattern="[A-Za-z0-9][A-Za-z0-9_.\-]*" autocomplete="username">
      </div>
      <div class="form-field">
        <label class="form-label" for="password">Password</label>
        <input class="input" id="password" type="password" placeholder="Password (8+ characters)" name="password" required minlength="8" autocomplete="new-password">
      </div>
      {{#if signup_code_required}}
      <div class="form-field">
        <label class="form-label" for="signup_code">Invitation code</label>
        <input class="input" id="signup_code" type="text" placeholder="Invitation code" name="signup_code" required autocomplete="off">
      </div>
      {{/if}}
      <button class="btn btn-primary btn-block" type="submit">Sign up</button>
    </form>
    {{else}}
    <p class="auth-sub">Sign-up is closed. Ask an administrator for an account.</p>
    {{/if}}

    <p class="auth-switch">Already have an account? <a href="/signin">Sign in</a></p>
  </div>
{{/inline}}
{{~> layout ~}}
