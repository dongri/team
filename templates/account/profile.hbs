{{#*inline "title"}}@{{user.username}} - Team{{/inline}}
{{#*inline "page"}}
  <div class="profile-head">
    {{> partials/avatar user cls="avatar-lg" px=60}}
    <div class="profile-name">@{{user.username}}</div>
  </div>

  <div class="tabs">
    <a class="tab {{kind_post_active}}" href="/{{user.username}}/post">Post</a>
    <a class="tab {{kind_nippo_active}}" href="/{{user.username}}/nippo">Nippo</a>
  </div>

  <ul class="item-list">
    {{#each posts}}
    {{> partials/post_item}}
    {{/each}}
  </ul>

  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/{{user.username}}/{{kind}}?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/{{user.username}}/{{kind}}?page={{next_page}}">Next &rarr;</a>
  </nav>
{{/inline}}
{{~> layout ~}}
