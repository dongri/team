{{#*inline "title"}}Feed - Team{{/inline}}
{{#*inline "page"}}
  {{#if pinneds}}
  <section class="section">
    <div class="section-head">
      <h2 class="section-title"><i class="fas fa-thumbtack"></i> Pinned</h2>
      <a class="section-more" href="/pinned/list">View all</a>
    </div>
    <ul class="item-list pinned-list">
      {{#each pinneds}}
      <li class="item-card pinned-card">
        <div class="item-main">
          <div class="item-title">
            <a href="/{{kind}}/show/{{id}}">{{title}}</a>
          </div>
          {{#if tags}}
          <div class="item-tags">
            {{#each tags}}
            <a class="tag-pill" href="/tag?name={{name}}">{{name}}</a>
            {{/each}}
          </div>
          {{/if}}
          <div class="item-meta"><span class="item-date">{{formated_created}}</span></div>
        </div>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Feed</h2>
    </div>
    <ul class="item-list">
      {{#each feeds}}
      <li class="item-card">
        <a class="item-avatar" href="/{{user.username}}">
          {{> partials/avatar user cls="avatar-md" px=40}}
        </a>
        <div class="item-main">
          {{#if comment}}
          <div class="item-meta">
            <a class="item-user" href="/{{user.username}}">@{{user.username}}</a>
            <span>commented on</span>
            <a class="item-context" href="/{{kind}}/show/{{id}}">{{title}}</a>
          </div>
          <div class="comment-bubble">{{body}}</div>
          {{/if}}
          {{#if post}}
          <div class="item-meta">
            <a class="item-user" href="/{{user.username}}">@{{user.username}}</a>
            <span>created a new post</span>
          </div>
          <div class="item-title"><a href="/{{kind}}/show/{{id}}">{{title}}</a></div>
          {{#if tags}}
          <div class="item-tags">
            {{#each tags}}
            <a class="tag-pill" href="/tag?name={{name}}">{{name}}</a>
            {{/each}}
          </div>
          {{/if}}
          {{/if}}
          {{#if gist}}
          <div class="item-meta">
            <a class="item-user" href="/{{user.username}}">@{{user.username}}</a>
            <span>created a new gist</span>
          </div>
          <div class="item-title"><a href="/gist/show/{{id}}">{{title}}</a></div>
          {{/if}}
          <div class="item-meta"><span class="item-date">{{formated_created}}</span></div>
        </div>
      </li>
      {{/each}}
    </ul>
  </section>

  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/?page={{next_page}}">Next &rarr;</a>
  </nav>
{{/inline}}
{{~> layout ~}}
