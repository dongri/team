{{#*inline "title"}}#{{tag_name}} - Team{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title"><span class="tag-pill tag-pill-lg">{{tag_name}}</span></h1>

  <ul class="item-list">
    {{#each posts}}
    {{> partials/post_item}}
    {{/each}}
  </ul>

  {{#if (gt total_page 1)}}
  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/tag?name={{tag_name}}&page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/tag?name={{tag_name}}&page={{next_page}}">Next &rarr;</a>
  </nav>
  {{/if}}
{{/inline}}
{{~> layout ~}}
