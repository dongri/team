{{#*inline "title"}}{{gist.description}} - Team{{/inline}}
{{#*inline "page_head"}}
{{> gist/head}}
{{/inline}}
{{#*inline "page"}}
  <article class="post">
    <div class="post-actions">
      <span class="post-actions-spacer"></span>
      {{#if editable}}
      <a class="btn btn-ghost btn-sm" href="/gist/edit/{{gist.id}}"><i class="fas fa-edit"></i> Edit</a>
      {{/if}}
      {{#if deletable}}
      <button class="btn btn-danger btn-sm" type="button" onclick="removeGist('{{gist.id}}')"><i class="fas fa-trash-alt"></i> Delete</button>
      {{/if}}
    </div>

    <h1 class="post-title">{{gist.description}}</h1>

    <div class="post-byline">
      <a class="item-avatar" href="/{{gist.user.username}}">
        {{> partials/avatar gist.user cls="avatar-md" px=40}}
      </a>
      <div>
        <a class="item-user" href="/{{gist.user.username}}">@{{gist.user.username}}</a>
        <div class="item-date">{{gist.formated_created}}</div>
      </div>
    </div>

    <div class="gist-file card">
      <div class="gist-filename mono" id="gist-filename">{{gist.filename}}</div>
      <textarea id="code" name="code" hidden>{{gist.code}}</textarea>
    </div>
  </article>

  <section class="comments">
    <h2 class="section-title">Comments</h2>
    <ul class="item-list">
      {{#each comments}}
      <li class="item-card comment-card">
        <a class="item-avatar" href="/{{comment.user.username}}">
          {{> partials/avatar comment.user cls="avatar-md" px=40}}
        </a>
        <div class="item-main">
          <div class="item-meta">
            <a class="item-user" href="/{{comment.user.username}}">@{{comment.user.username}}</a>
            {{#if editable}}
            <span class="comment-tools">
              <button class="icon-btn" type="button" onclick="editComment({{comment.id}})" aria-label="Edit"><i class="fas fa-edit"></i></button>
              <button class="icon-btn" type="button" onclick="removeComment({{comment.id}})" aria-label="Delete"><i class="fas fa-trash-alt"></i></button>
            </span>
            {{/if}}
          </div>
          <div class="marked" hidden id="comment_view_{{comment.id}}">{{comment.body}}</div>
          <form action="/gist/comment/{{comment.id}}" method="post" id="comment_input_{{comment.id}}" hidden>
            <input type="hidden" name="action" value="update" id="comment_action_{{comment.id}}">
            <div class="form-field">
              <textarea placeholder="Comment" name="body" class="textarea" required>{{comment.body}}</textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Update</button>
          </form>
        </div>
      </li>
      {{/each}}
    </ul>

    <form class="comment-form" action="/gist/comment" method="post">
      <input type="hidden" name="id" value="{{gist.id}}">
      <div class="form-field">
        <textarea placeholder="Post a comment" name="body" id="input-comment" class="textarea" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Comment</button>
    </form>
  </section>

  <script>
    CodeMirror.modeURL = "/codemirror/mode/%N/%N.js";
    var editor = CodeMirror.fromTextArea(document.getElementById("code"), {
      lineNumbers: true,
      matchBrackets: true,
      readOnly: true,
      viewportMargin: Infinity
    });
    editor.setOption("theme", document.documentElement.getAttribute("data-theme") === "black" ? "blackboard" : "default");

    (function () {
      var val = document.getElementById("gist-filename").innerText.trim();
      var m, mode, spec;
      if (m = /.+\.([^.]+)$/.exec(val)) {
        var info = CodeMirror.findModeByExtension(m[1]);
        if (info) { mode = info.mode; spec = info.mime; }
      } else if (/\//.test(val)) {
        var info = CodeMirror.findModeByMIME(val);
        if (info) { mode = info.mode; spec = val; }
      } else {
        mode = spec = val;
      }
      if (mode) {
        editor.setOption("mode", spec);
        CodeMirror.autoLoadMode(editor, mode);
      } else {
        editor.setOption("mode", "text/plain");
        CodeMirror.autoLoadMode(editor, "null");
      }
    })();

    function editComment(id) {
      document.getElementById('comment_view_' + id).hidden = true;
      document.getElementById('comment_input_' + id).hidden = false;
    }
    function removeComment(id) {
      if (confirm('Are you sure?')) {
        document.getElementById('comment_action_' + id).value = 'delete';
        document.getElementById('comment_input_' + id).submit();
      }
    }
    function removeGist(id) {
      if (confirm('Are you sure?')) {
        window.location.href = '/gist/delete/' + id;
      }
    }
  </script>
{{/inline}}
{{~> layout ~}}
