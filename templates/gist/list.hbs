{{#*inline "title"}}Gist - Team{{/inline}}
{{#*inline "page"}}
  <div class="page-head">
    <h1 class="page-title">Gist</h1>
    <a class="btn btn-primary" href="/gist/new"><i class="fas fa-code"></i> New Gist</a>
  </div>

  <ul class="item-list">
    {{#each gists}}
    <li class="item-card">
      <a class="item-avatar" href="/{{user.username}}">
        {{> partials/avatar user cls="avatar-md" px=40}}
      </a>
      <div class="item-main">
        <div class="item-meta">
          <a class="item-user" href="/{{user.username}}">@{{user.username}}</a>
          <span class="item-date">{{formated_created}}</span>
        </div>
        <div class="item-title">
          <a href="/gist/show/{{id}}">{{description}}</a>
        </div>
        <div class="item-meta"><span class="mono">{{filename}}</span></div>
      </div>
    </li>
    {{/each}}
  </ul>

  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/gist/list?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/gist/list?page={{next_page}}">Next &rarr;</a>
  </nav>
{{/inline}}
{{~> layout ~}}
