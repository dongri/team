{{#*inline "title"}}Pinned posts - Team{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title"><i class="fas fa-thumbtack"></i> Pinned posts</h1>
  <ul class="item-list">
    {{#each pinneds}}
    {{> partials/post_item}}
    {{/each}}
  </ul>

  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/pinned/list?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/pinned/list?page={{next_page}}">Next &rarr;</a>
  </nav>
{{/inline}}
{{~> layout ~}}
