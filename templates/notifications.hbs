{{#*inline "title"}}Notifications - Team{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title">Notifications</h1>
  <ul class="item-list">
    {{#each notifications}}
    <li class="item-card">
      <a class="item-avatar" href="/{{user.username}}">
        {{> partials/avatar user cls="avatar-md" px=40}}
      </a>
      <div class="item-main">
        <div class="item-meta">
          <a class="item-user" href="/{{user.username}}">@{{user.username}}</a>
          {{#if is_like}}
          <span>liked your</span>
          <a class="item-context" href="{{path}}">Tweet</a>
          {{else}}
          <span>commented on</span>
          <a class="item-context" href="{{path}}">Post</a>
          {{/if}}
        </div>
        <div class="comment-bubble">{{#if is_like}}<i class="fas fa-heart notification-like-icon"></i> {{/if}}{{body}}</div>
        <div class="item-meta"><span class="item-date">{{formated_created}}</span></div>
      </div>
    </li>
    {{/each}}
  </ul>

  {{#if (gt total_page 1)}}
  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/notifications?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/notifications?page={{next_page}}">Next &rarr;</a>
  </nav>
  {{/if}}
{{/inline}}
{{~> layout ~}}
