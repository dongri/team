{{#*inline "title"}}Stocked posts - Team{{/inline}}
{{#*inline "page"}}
  <h1 class="page-title"><i class="fas fa-bookmark"></i> Stocked posts</h1>
  <ul class="item-list">
    {{#each posts}}
    {{> partials/post_item}}
    {{/each}}
  </ul>

  {{#if (gt total_page 1)}}
  <nav class="pagination" role="navigation" aria-label="pagination">
    <a class="page-btn" href="/stocked/list?page={{prev_page}}">&larr; Prev</a>
    <span class="page-status">{{current_page}} / {{total_page}}</span>
    <a class="page-btn" href="/stocked/list?page={{next_page}}">Next &rarr;</a>
  </nav>
  {{/if}}
{{/inline}}
{{~> layout ~}}
