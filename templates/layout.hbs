<!doctype html>
<html lang="ja" data-theme="{{#if login_user.theme}}{{login_user.theme}}{{else}}light{{/if}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicons/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
    <meta name="theme-color" content="#0f1115">
    <title>{{#> title}}Team{{/title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/css/fontawesome-all.min.css" rel="stylesheet">
    <link href="/css/highlight.default.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="/js/markdown-it.min.js"></script>
    <script src="/js/highlight.min.js"></script>
    <script src="/js/emoji-list.js"></script>
    <script src="/js/identicon.js" defer></script>
    <script src="/js/app.js" defer></script>
    {{#> page_head}}{{/page_head}}
  </head>
  <body>
    {{#> page_header}}{{> header}}{{/page_header}}
    <main class="container">
      {{~> page}}
    </main>
    {{> footer}}
    <script>
      // Render default avatars from their username hash. Kept inline (rather
      // than in app.js) so it ships with the never-cached HTML — a CDN can't
      // serve a stale copy and leave avatars broken.
      document.addEventListener('DOMContentLoaded', function () {
        if (!window.Identicon) return;
        document.querySelectorAll('img[data-identicon-hash]').forEach(function (el) {
          var size = parseInt(el.getAttribute('width'), 10) || 40;
          var svg = new Identicon(el.getAttribute('data-identicon-hash'), {
            size: size * 2,
            format: 'svg',
          }).toString();
          el.src = 'data:image/svg+xml;base64,' + svg;
        });
      });
    </script>
  </body>
</html>
