# Copy this file to `.env` and fill in your values.
#   $ cp .env.example .env
# `.env` is loaded automatically by the app (dotenvy) and by docker-compose.

# Server port
PORT=3000

# PostgreSQL connection URL
TEAM_DATABASE_URL=postgres://root:@localhost:5432/team

# Public origin of this app (used for redirects, generated URLs and the
# same-origin check on form submissions). Use https:// in production so
# session cookies get the Secure flag.
TEAM_DOMAIN=http://localhost:3000

# Set to true when running behind a reverse proxy (Nginx etc.) so the client
# address is read from X-Forwarded-For for logging and sign-in throttling.
# Leave false when the app is reached directly: the header is then
# attacker-controlled.
TEAM_TRUST_PROXY=false

# Slack incoming webhook — all activity (posts, nippo, comments, gists,
# tweets, tag updates) is notified here (optional)
TEAM_SLACK_WEBHOOK_URL=

# Google OAuth (optional — leave empty to use username/password only)
TEAM_GOOGLE_CLIENT_ID=
TEAM_GOOGLE_CLIENT_SECRET=
TEAM_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google
# Restrict Google sign-in to this email domain. Strongly recommended:
# without it, any Google account can sign in.
TEAM_GOOGLE_ALLOW_DOMAIN=

# Username/password sign-up.
#   TEAM_SIGNUP_ENABLED=false  -> /signup is closed (Google sign-in still works)
#   TEAM_SIGNUP_CODE=<secret>  -> sign-up requires this invitation code
# With sign-up open and no code, anyone who can reach the server can create
# an account and read everything. Close it once your team is onboarded.
TEAM_SIGNUP_ENABLED=true
TEAM_SIGNUP_CODE=

# Header menu items and their order
TEAM_MENU=post,nippo,gist,tweet,tag

# Default theme: light | black
TEAM_THEME=light

# Secret used to sign session cookies. REQUIRED, at least 32 characters;
# the app refuses to start otherwise. Generate with:
#   $ openssl rand -hex 32
TEAM_SECRET_COOKIE=change-me-to-a-long-random-string

# Rust backtraces on error (optional)
RUST_BACKTRACE=1
